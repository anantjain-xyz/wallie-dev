-- The pgTAP suite and the PostgREST smoke both run this setup in a transaction.
set local request.jwt.claim.role = 'service_role';
select set_config('wallie.diagnosis_fixture_prefix', :'diagnosis_fixture_prefix', true);

create function pg_temp.diagnosis_fixture_id(p_slot integer) returns uuid language sql stable as $$
  select (current_setting('wallie.diagnosis_fixture_prefix') || '-0000-4000-8000-' || lpad(p_slot::text, 12, '0'))::uuid;
$$;

insert into auth.users(id, email) values
  (pg_temp.diagnosis_fixture_id(1), 'diagnosis-owner-' || :'diagnosis_fixture_prefix' || '@example.test'),
  (pg_temp.diagnosis_fixture_id(2), 'diagnosis-manager-' || :'diagnosis_fixture_prefix' || '@example.test'),
  (pg_temp.diagnosis_fixture_id(3), 'diagnosis-reader-' || :'diagnosis_fixture_prefix' || '@example.test'),
  (pg_temp.diagnosis_fixture_id(4), 'diagnosis-outsider-' || :'diagnosis_fixture_prefix' || '@example.test');
insert into public.workspaces(id, slug, name)
values (pg_temp.diagnosis_fixture_id(11), 'diagnosis-fixture-' || :'diagnosis_fixture_prefix', 'Diagnosis fixture');
insert into public.workspace_members(id, workspace_id, user_id, kind, role) values
  (pg_temp.diagnosis_fixture_id(21), pg_temp.diagnosis_fixture_id(11), pg_temp.diagnosis_fixture_id(1), 'human', 'owner'),
  (pg_temp.diagnosis_fixture_id(22), pg_temp.diagnosis_fixture_id(11), pg_temp.diagnosis_fixture_id(2), 'human', 'member'),
  (pg_temp.diagnosis_fixture_id(23), pg_temp.diagnosis_fixture_id(11), pg_temp.diagnosis_fixture_id(3), 'human', 'member');
create temp table diagnosis_scope as
select factory.workspace_id, factory.id as factory_id, pg_temp.diagnosis_fixture_id(1) as owner_id
from public.factories factory where factory.workspace_id = pg_temp.diagnosis_fixture_id(11) and factory.is_default;
grant select on diagnosis_scope to authenticated;
select public.grant_factory_membership(workspace_id, factory_id, owner_id, pg_temp.diagnosis_fixture_id(21), 'manager')
from diagnosis_scope;
select public.grant_factory_membership(workspace_id, factory_id, owner_id, pg_temp.diagnosis_fixture_id(22), 'manager')
from diagnosis_scope;
select public.grant_factory_membership(workspace_id, factory_id, owner_id, pg_temp.diagnosis_fixture_id(23), 'member')
from diagnosis_scope;

insert into public.pipelines(id, workspace_id, factory_id, name, is_default)
select pg_temp.diagnosis_fixture_id(31), workspace_id, factory_id, 'Diagnosis fixture pipeline', true from diagnosis_scope;
insert into public.pipeline_stages(id, workspace_id, pipeline_id, position, slug, name, prompt_template_md)
values (pg_temp.diagnosis_fixture_id(32), pg_temp.diagnosis_fixture_id(11), pg_temp.diagnosis_fixture_id(31),
  1, 'build', 'Build', 'Produce a report.');
insert into public.github_installations(id, workspace_id, installation_id, installation_url, app_id, target_type,
  target_name, permissions)
values (pg_temp.diagnosis_fixture_id(40), pg_temp.diagnosis_fixture_id(11), :'diagnosis_fixture_prefix'::bigint + 40,
  'https://github.test/installations/' || (:'diagnosis_fixture_prefix'::bigint + 40), 63500, 'Organization', 'fixture', '{"contents":"write","pull_requests":"write"}');
insert into public.github_repositories(id, workspace_id, factory_id, github_installation_id, repo_id,
  name, full_name, private, html_url, default_branch)
select pg_temp.diagnosis_fixture_id(41), workspace_id, factory_id, pg_temp.diagnosis_fixture_id(40), :'diagnosis_fixture_prefix'::bigint + 41,
  'diagnosis', 'fixture/diagnosis', true, 'https://github.test/fixture/diagnosis', 'main' from diagnosis_scope;
insert into public.user_codex_credentials(user_id, credential_type, encrypted_credential)
values (pg_temp.diagnosis_fixture_id(1), 'platform_api_key', 'production-only-fixture-ciphertext');
insert into public.workspace_sandbox_settings(workspace_id, active_provider)
values (pg_temp.diagnosis_fixture_id(11), 'e2b') on conflict (workspace_id) do update set active_provider = excluded.active_provider;
insert into public.workspace_e2b_sandbox_connections(workspace_id, encrypted_api_key)
values (pg_temp.diagnosis_fixture_id(11), 'production-only-fixture-sandbox');
create temp table diagnosis_agent as
select revision.* from diagnosis_scope scope cross join lateral public.create_factory_agent(
  scope.workspace_id, scope.factory_id, scope.owner_id, 'Reviewer', 'reviewer', 'Diagnose from evidence.') revision;
create temp table diagnosis_skill as
select revision.id from diagnosis_scope scope cross join lateral public.create_factory_skill(
  scope.workspace_id, scope.factory_id, scope.owner_id, 'How to read evidence', 'read-evidence', 'Cite exact evidence.') revision;
create temp table approved_provider as
select revision.id from diagnosis_scope scope cross join lateral public.configure_factory_judge_profile(
  scope.workspace_id, scope.owner_id, 0, 'openai/gpt-4.1-mini', 'openai', false, false,
  :'diagnosis_inference_ciphertext') revision;

with compiled as (
  select scope.*, jsonb_build_object('schemaVersion', 2, 'kind', 'serial', 'sandboxProvider', 'e2b',
    'pipelineId', pg_temp.diagnosis_fixture_id(31), 'repositoryId', pg_temp.diagnosis_fixture_id(41),
    'scorerRevisionIds', '[]'::jsonb, 'skillIds', jsonb_build_array(skill.id), 'toolIds', '[]'::jsonb,
    'operatingRulesMd', '', 'operatingRuleStageIds', '[]'::jsonb, 'agent', jsonb_build_object(
      'provider', 'codex', 'model', 'gpt-5.5', 'concurrencyLimit', 1, 'stallTimeoutMs', 900000,
      'maxRetries', 3, 'maxTurns', 5), 'stages', jsonb_build_array(jsonb_build_object(
        'id', pg_temp.diagnosis_fixture_id(32), 'slug', 'build', 'name', 'Build', 'description', '',
        'promptTemplateMd', 'Produce a report.', 'anyoneCanApprove', true,
        'previousStageIds', '[]'::jsonb, 'approverMemberIds', '[]'::jsonb)))::text as definition
  from diagnosis_scope scope cross join diagnosis_skill skill
), revision as (
  insert into public.factory_definition_revisions(id, workspace_id, factory_id, schema_version,
    definition_json, canonical_digest, created_by)
  select pg_temp.diagnosis_fixture_id(51), workspace_id, factory_id, 2, definition,
    encode(sha256(convert_to(definition, 'UTF8')), 'hex'), owner_id from compiled
  returning id, workspace_id, factory_id, created_by
)
insert into public.factory_definition_activations(workspace_id, factory_id, revision_id, activation_number, created_by)
select workspace_id, factory_id, id, 1, created_by from revision;
select public.set_git_continuity_release(true, revision, 'Diagnosis fixture')
from public.get_git_continuity_release_state() where not enabled;

create temp table diagnosis_source as select result.*, gen_random_uuid() as asset_id
from public.create_session_with_first_job(pg_temp.diagnosis_fixture_id(11), pg_temp.diagnosis_fixture_id(21),
  'Failed production run', 'Produce exact evidence.', 'codex', 'gpt-5.5') result;
update public.agent_jobs set git_continuity_release_revision = (select revision from public.get_git_continuity_release_state()),
  status = 'running', attempt_count = 1 where id = (select job_id from diagnosis_source);
update diagnosis_source set run_id = public.start_session_job_attempt(job_id, 1, pg_temp.diagnosis_fixture_id(32), 0,
  'codex', 'gpt-5.5', 'project', 'wallie/diagnosis-fixture-' || job_id::text);
select public.pin_session_job_git_input(job_id, 1, run_id, pg_temp.diagnosis_fixture_id(41), 'main', repeat('a', 40)) from diagnosis_source;
select public.pin_session_validation_plan(run_id, repeat('a', 40), repeat('b', 40),
  '{"version":1,"commands":[{"key":"tests","command":"pnpm test","timeoutSeconds":60,"reports":[]}]}') from diagnosis_source;
insert into storage.objects(bucket_id, name, metadata)
select 'session-validation-evidence', pg_temp.diagnosis_fixture_id(11)::text || '/' || run_id::text || '/' || asset_id::text,
  '{"mimetype":"text/plain","size":20}' from diagnosis_source;
select public.record_session_validation_evidence(run_id, repeat('a', 40), repeat('b', 40),
  jsonb_build_array(jsonb_build_object('key', 'tests', 'command', 'pnpm test', 'provenance', 'harness', 'status', 'failed',
    'exitCode', 1, 'startedAt', clock_timestamp(), 'completedAt', clock_timestamp(), 'commitSha', repeat('a', 40),
    'treeSha', repeat('b', 40), 'finalCommitSha', repeat('a', 40), 'finalTreeSha', repeat('b', 40),
    'reportKeys', '[]'::jsonb, 'missingRequiredReports', '[]'::jsonb)),
  jsonb_build_array(jsonb_build_object('id', asset_id, 'key', 'tests/log', 'kind', 'log', 'required', false, 'sha256', repeat('c', 64),
    'contentType', 'text/plain', 'sizeBytes', 20, 'storagePath', pg_temp.diagnosis_fixture_id(11)::text || '/' || run_id::text || '/' || asset_id::text)))
from diagnosis_source;
select public.process_factory_failure_cohorts(100);

create temp table diagnosis_cohort as
select cohort.id from internal.factory_failure_cohorts cohort join diagnosis_scope scope
on (cohort.workspace_id, cohort.factory_id) = (scope.workspace_id, scope.factory_id);
