-- Shared branch fixtures. Set the namespace and group flags in each SQL suite.
set local request.jwt.claim.role = 'service_role';
select set_config('wallie.op651_fixture_namespace', :'op651_fixture_namespace', false);
select set_config('wallie.op651_parallel_only', :'op651_parallel_only', true);

create function pg_temp.op651_id(slot integer) returns uuid language sql stable as $$
  select (current_setting('wallie.op651_fixture_namespace') || '-0000-4000-8000-' || lpad(slot::text, 12, '0'))::uuid
$$;
select set_config('request.jwt.claim.sub', pg_temp.op651_id(1)::text, true);
insert into auth.users(id, email)
values (pg_temp.op651_id(1),'op651-' || current_setting('wallie.op651_fixture_namespace') || '@example.test');
insert into public.workspaces(id, slug, name) values (pg_temp.op651_id(11),'op651-' || current_setting('wallie.op651_fixture_namespace'),'Workflow branch fixture');
insert into public.workspace_members(id, workspace_id, user_id, kind, role)
values (pg_temp.op651_id(21), pg_temp.op651_id(11), pg_temp.op651_id(1), 'human', 'owner');

create temp table op651_scope as
select workspace_id, id as factory_id from public.factories
where workspace_id = pg_temp.op651_id(11) and is_default;
insert into public.factory_agent_prompt_revisions(id, workspace_id, factory_id, agent_id, revision_number,
  prompt_md, prompt_sha256, created_by)
select pg_temp.op651_id(91), workspace_id, factory_id, id, 2,
  'Choose a configured destination.', encode(sha256(convert_to('Choose a configured destination.', 'UTF8')), 'hex'),
  pg_temp.op651_id(21)
from public.factory_agents where workspace_id = pg_temp.op651_id(11) and is_default;
insert into public.pipelines(id, workspace_id, factory_id, name, is_default)
select pg_temp.op651_id(31), workspace_id, factory_id, 'Workflow receipt pipeline', true from op651_scope;
insert into public.pipeline_stages(id, pipeline_id, workspace_id, position, slug, name)
values (pg_temp.op651_id(32), pg_temp.op651_id(31), pg_temp.op651_id(11), 1, 'inspect-output', 'Inspect output');
insert into public.github_installations(id, workspace_id, installation_id, installation_url, app_id, target_type, target_name, permissions)
values (pg_temp.op651_id(33), pg_temp.op651_id(11), current_setting('wallie.op651_fixture_namespace')::bigint + 33,
  'https://github.test/installations/' || (current_setting('wallie.op651_fixture_namespace')::bigint + 33),
  current_setting('wallie.op651_fixture_namespace')::bigint, 'Organization', 'Fixture', '{"contents":"write","pull_requests":"write"}');
insert into public.github_repositories(id, workspace_id, factory_id, github_installation_id, repo_id, name, full_name, private, html_url, default_branch)
select pg_temp.op651_id(34), workspace_id, factory_id, pg_temp.op651_id(33), current_setting('wallie.op651_fixture_namespace')::bigint + 34,
  'workflow-fixture', 'fixture/workflow-fixture', true, 'https://github.test/fixture/workflow-fixture', 'main'
from op651_scope;

-- Root's grant can read A and B. Its pinned definition only exercises A.
-- C is a live same-factory repository outside both inherited scope envelopes.
insert into public.github_repositories(id, workspace_id, factory_id, github_installation_id, repo_id,
  name, full_name, private, html_url, default_branch)
select pg_temp.op651_id(repo.slot), scope.workspace_id, scope.factory_id, pg_temp.op651_id(33),
  current_setting('wallie.op651_fixture_namespace')::bigint + repo.slot, repo.name, 'fixture/' || repo.name, true, 'https://github.test/fixture/' || repo.name, 'main'
from op651_scope scope
cross join (values (61, 'context-a'), (62, 'context-b'), (63, 'context-c')) repo(slot, name);

create temp table grant_scope as
select principal.*, policy.id as policy_id
from op651_scope scope
cross join lateral public.create_service_principal(
  scope.workspace_id, scope.factory_id, pg_temp.op651_id(1), 'Workflow router', 'workflow-router') principal
cross join lateral public.save_execution_policy(scope.workspace_id, pg_temp.op651_id(1), 0,
  '{"version":1,"maxRepairAttempts":1,"maxExecutionMs":60000,"maxTotalTokens":null,"maxCostUsd":null}') policy;

create temp table approved_grants as
select intent.scenario, intent.revision_slot, intent.activation_number, approved.*
from grant_scope scope
cross join (values
  ('root', 43, 5, array[pg_temp.op651_id(61), pg_temp.op651_id(62)], interval '2 hours'),
  ('narrow', 44, 1, '{}'::uuid[], interval '1 hour'),
  ('outside-parent-definition', 45, 2, array[pg_temp.op651_id(62)], interval '1 hour'),
  ('outside-parent-grant', 46, 3, array[pg_temp.op651_id(63)], interval '1 hour'),
  ('nested', 47, 4, '{}'::uuid[], interval '45 minutes')
) intent(scenario, revision_slot, activation_number, context_repositories, expires_in)
cross join lateral public.approve_factory_execution_grant(
  scope.workspace_id, scope.factory_id, pg_temp.op651_id(1), scope.id, pg_temp.op651_id(34),
  intent.context_repositories, '{}', scope.policy_id, pg_temp.op651_id(21),
  clock_timestamp() + intent.expires_in, 0, null, '{sessions:create}'::public.factory_command_scope[]) approved;
create temp view op651_grant as select * from approved_grants where scenario = 'root';
create temp view scoped_child_grants as select * from approved_grants where scenario not in ('root', 'nested');

insert into public.workspace_secrets(id, workspace_id, key, encrypted_value)
select pg_temp.op651_id(revision_slot + 30), workspace_id, 'OP651_GRANT_KEY_' || revision_slot, 'fixture-ciphertext'
from approved_grants;
insert into public.workspace_sandbox_settings(workspace_id, active_provider) values (pg_temp.op651_id(11), 'e2b')
on conflict (workspace_id) do update set active_provider = excluded.active_provider;
insert into public.workspace_e2b_sandbox_connections(workspace_id, encrypted_api_key)
values (pg_temp.op651_id(11), 'fixture-sandbox-ciphertext');

create temp table op651_fixture_delivery_policy(id uuid);
\if :{?op652_join_evidence}
insert into op651_fixture_delivery_policy
select policy.id from public.save_delivery_policy(pg_temp.op651_id(11), pg_temp.op651_id(31),
  pg_temp.op651_id(1), 0, '{"version":1,"deliveryMode":"code","requiredChecks":[],
  "minimumApprovals":0,"requireCodeOwnerReview":false,"requireResolvedThreads":false,
  "requiredEvidence":["tests"],"freshnessSeconds":300,"requireArtifactApprovalForDelivery":false}') policy;
\endif

create temp table scoped_revisions as
select grant_row.scenario, pg_temp.op651_id(grant_row.revision_slot) as revision_id, grant_row.activation_number,
  grant_row.id as grant_id, grant_row.version as grant_version, binding.id as binding_id,
  grant_row.workspace_id, grant_row.factory_id,
  jsonb_build_object(
    'schemaVersion', 1, 'kind', 'serial', 'pipelineId', pg_temp.op651_id(31),
    'repositoryId', grant_row.github_repository_id, 'sandboxProvider', 'e2b',
    'readContextRepositoryIds', to_jsonb(case when grant_row.scenario = 'root' then array[pg_temp.op651_id(61)]
      else grant_row.read_context_repository_ids end),
    'credentialBindingId', binding.id, 'executionGrant', jsonb_build_object('id', grant_row.id, 'version', grant_row.version),
    'implementationAgent', jsonb_build_object('agentId', prompt.agent_id, 'promptRevisionId', prompt.id,
      'promptMd', prompt.prompt_md, 'promptSha256', prompt.prompt_sha256),
    'agent', jsonb_build_object('provider', 'codex', 'model', 'gpt-5.5', 'effort', 'high',
      'concurrencyLimit', 3, 'stallTimeoutMs', 900000, 'maxRetries', 3, 'maxTurns', 5),
    'executionPolicyRevisionId', grant_row.execution_policy_revision_id, 'deliveryPolicyRevisionId',
    case when grant_row.scenario='root' then (select id from op651_fixture_delivery_policy) end,
    'skillIds', '[]'::jsonb, 'toolIds', '[]'::jsonb, 'operatingRulesMd', '', 'operatingRuleStageIds', '[]'::jsonb,
    'stages', jsonb_build_array(jsonb_build_object('id', pg_temp.op651_id(32), 'slug', 'inspect-output',
      'name', 'Inspect output', 'description', '', 'promptTemplateMd', 'Inspect the admitted output.',
      'anyoneCanApprove', false, 'previousStageIds', '[]'::jsonb, 'approverMemberIds', jsonb_build_array(pg_temp.op651_id(21))))
  )::text as body
from approved_grants grant_row
join public.factory_agent_prompt_revisions prompt on prompt.id = pg_temp.op651_id(91)
cross join lateral public.create_factory_secret_binding(grant_row.workspace_id, grant_row.factory_id, pg_temp.op651_id(1),
  grant_row.id, grant_row.version, prompt.agent_id, 'codex', pg_temp.op651_id(grant_row.revision_slot + 30)) binding;
create temp view scoped_child_revisions as select * from scoped_revisions where scenario not in ('root', 'nested');

insert into public.factory_definition_revisions(id, workspace_id, factory_id, schema_version, definition_json, canonical_digest, created_by)
select revision_id, workspace_id, factory_id, 1, body, encode(sha256(convert_to(body, 'UTF8')), 'hex'), pg_temp.op651_id(21)
from scoped_revisions;
insert into public.factory_definition_activations(workspace_id, factory_id, revision_id, activation_number, created_by)
select workspace_id, factory_id, revision_id, activation_number, pg_temp.op651_id(21)
from scoped_revisions order by activation_number;
select public.issue_factory_machine_token(workspace_id, factory_id, pg_temp.op651_id(1), id, version,
  pg_temp.op651_id(36), repeat('a', 64), 'Delegated grant fixture', '{sessions:create}') from op651_grant;
create function pg_temp.op651_create_service_root(p_slot integer, p_title text) returns jsonb language plpgsql as $$
declare
  scope record;
  permit record;
  request_id uuid := gen_random_uuid();
  receipt jsonb;
begin
  select workspace_id, factory_id into strict scope from op651_scope;
  select * into strict permit from public.admit_factory_command(scope.workspace_id, scope.factory_id, 'machine_token',
    pg_temp.op651_id(36), repeat('a', 64), 'sessions:create', request_id, repeat('b', 64), 'api');
  if permit.status <> 'admitted' then raise exception 'Service route fixture admission failed: %', permit.status; end if;
  receipt := public.execute_factory_session_mutation(scope.workspace_id, scope.factory_id, 'machine_token',
    pg_temp.op651_id(36), repeat('a', 64), request_id, repeat('b', 64), 'api', permit.admission_id, permit.lease_id,
    'create', pg_temp.op651_id(p_slot), jsonb_build_object('title', p_title, 'prompt', 'Choose a configured route.',
      'agentId', (select agent_id from public.factory_agent_prompt_revisions where id = pg_temp.op651_id(91)),
      'repositoryId', pg_temp.op651_id(34), 'draftSpecification', false));
  perform public.release_factory_command_admission(permit.admission_id, permit.lease_id);
  return receipt;
end;
$$;

create temp table delegated_root as
select fixture.scenario, scope.*, fields.*
from op651_scope scope
cross join (values ('parallel', 101), ('bounded', 102), ('canceled', 103), ('partial', 104), ('paused', 105))
  fixture(scenario, request_slot)
cross join lateral jsonb_to_record(pg_temp.op651_create_service_root(fixture.request_slot,
  'Grant narrowing root ' || fixture.scenario)) fields(
  "sessionId" uuid, "jobId" uuid, "runId" uuid
) where fixture.scenario = 'parallel' or not current_setting('wallie.op651_parallel_only')::boolean;
create temp table op651_release_before as select * from public.get_git_continuity_release_state();
create temp table op651_release_enabled as
select current.* from op651_release_before prior
cross join lateral public.set_git_continuity_release(true, prior.revision, 'Isolated OP651 fixture') current
where not prior.enabled;

create function pg_temp.adopt_source_checkpoint(
  p_session_id uuid, p_job_id uuid, p_expected_artifact_version integer default 0
)
returns uuid language plpgsql as $$
declare
  started uuid;
  lease uuid;
begin
  update public.agent_jobs set status = 'running', attempt_count = 1,
    git_continuity_release_revision = (select revision from public.get_git_continuity_release_state())
  where id = p_job_id and status = 'queued';
  started := public.start_session_job_attempt(p_job_id, 1, pg_temp.op651_id(32), p_expected_artifact_version,
    'codex', 'gpt-5.5', 'code', 'wallie/op651-smoke-' || p_job_id);
  if started is null then raise exception 'Root attempt failed to start.'; end if;
  perform public.pin_session_job_git_input(p_job_id, 1, started, pg_temp.op651_id(34), 'main', repeat('a', 40));
  if not found or not public.prepare_session_source_and_checkpoint_publication(started, pg_temp.op651_id(34), 'main',
    repeat('a', 40), repeat('a', 40), 'Root source', 'Delegation source proof', '', '', '',
    p_expected_artifact_version, 'Private root checkpoint.') then
    raise exception 'Root checkpoint preparation failed.';
  end if;
  lease := public.claim_session_checkpoint_publication(started);
  if lease is null or not public.adopt_session_checkpoint_publication(started, lease, null, null) then
    raise exception 'Root checkpoint adoption failed.';
  end if;
  if not exists (select 1 from public.session_git_heads h where (h.session_id, h.checkpoint_run_id) = (p_session_id, started)) then
    raise exception 'Root checkpoint did not become the accepted head.';
  end if;
  return started;
end;
$$;
create temp table root_checkpoint as
select root.*, pg_temp.adopt_source_checkpoint("sessionId", "jobId") as checkpoint_run_id from delegated_root root;

create temp table branch_graphs as
select checkpoint.scenario, jsonb_build_object(
  'schemaVersion', 1, 'kind', 'graph', 'entryNodeId', 'branch.split',
  'nodes', jsonb_build_array(
    jsonb_build_object('id', 'branch.split', 'kind', 'branch'),
    jsonb_build_object('id', 'agent.required', 'kind', 'agent', 'agentPromptRevisionId', pg_temp.op651_id(91), 'grantId', approved.id),
    jsonb_build_object('id', 'agent.optional', 'kind', 'agent', 'agentPromptRevisionId', pg_temp.op651_id(91), 'grantId', approved.id),
    jsonb_build_object('id', 'join.finish', 'kind', 'join')
  ),
  'edges', '[
    {"id":"run.required","kind":"branch","from":"branch.split","to":"agent.required","required":true},
    {"id":"run.optional","kind":"branch","from":"branch.split","to":"agent.optional","required":false},
    {"id":"required.output","kind":"branch-result","from":"agent.required","to":"join.finish"},
    {"id":"optional.output","kind":"branch-result","from":"agent.optional","to":"join.finish"}
  ]'::jsonb,
  'grants', jsonb_build_array(jsonb_build_object('id', approved.id, 'version', approved.version)),
  'delegationPolicy', jsonb_build_object('maxChildren', 2,
    'maxConcurrentChildren', case when checkpoint.scenario = 'bounded' then 1 else 2 end,
    'maxAttempts', 6, 'maxTotalTokens', 1000, 'maxTokensPerAttempt', 50, 'maxCostUsd', 2, 'maxCostUsdPerAttempt', 0.2,
    'targets', jsonb_build_object(
      'agent.required', jsonb_build_object('definitionRevisionId', narrow.id, 'definitionDigest', narrow.canonical_digest),
      'agent.optional', jsonb_build_object('definitionRevisionId', optional.id, 'definitionDigest', optional.canonical_digest)))
)::text as body
from root_checkpoint checkpoint cross join op651_grant approved
join public.factory_definition_revisions narrow on narrow.id = pg_temp.op651_id(44)
join public.factory_definition_revisions optional on optional.id = pg_temp.op651_id(47);

create temp table branch_owner as
select root.*, registered.graph_revision_id, started.*
from root_checkpoint root
join public.session_factory_admission_inputs pin on pin.session_id = root."sessionId"
join branch_graphs graph on graph.scenario = root.scenario
cross join lateral public.register_factory_workflow_graph_revision(
  pin.workspace_id, pin.factory_id, pin.definition_revision_id, pin.definition_digest,
  graph.body, encode(sha256(convert_to(graph.body, 'UTF8')), 'hex')) registered
cross join lateral public.start_factory_workflow_graph_execution(root."sessionId", root.workspace_id, root.factory_id,
  registered.graph_revision_id, root.checkpoint_run_id) started;

create function pg_temp.open_group(p_scenario text, p_override_checkpoint uuid default null)
returns table(group_id uuid, created boolean) language sql as $$
  select opened.* from branch_owner root
  cross join lateral public.open_factory_workflow_branch_group(
    root."sessionId", root.workspace_id, root.factory_id, root.execution_generation,
    root.ownership_token, root.entry_occurrence_id, coalesce(p_override_checkpoint, root.checkpoint_run_id)) opened
  where root.scenario = p_scenario
$$;

\if :op651_open_groups
create temp table branch_groups as
select root.scenario, opened.* from branch_owner root
cross join lateral pg_temp.open_group(root.scenario) opened;

create function pg_temp.admit_slot(p_scenario text, p_edge_id text, p_override_group uuid default null)
returns table(target_occurrence_id uuid, child_session_id uuid, job_id uuid, run_id uuid, created boolean)
language sql as $$
  select admitted.* from branch_owner root join branch_groups groups using (scenario)
  cross join lateral public.admit_factory_workflow_branch_slot(
    root."sessionId", root.workspace_id, root.factory_id, root.execution_generation,
    root.ownership_token, coalesce(p_override_group, groups.group_id), p_edge_id) admitted
  where root.scenario = p_scenario
$$;
\endif

create function pg_temp.adopt_branch_code(p_session_id uuid, p_job_id uuid, p_output_sha text)
returns uuid language plpgsql as $$
declare
  execution_id uuid;
  lease uuid;
  ref text;
  bundle bytea := convert_to('retained-code-fixture ' || p_output_sha, 'UTF8');
begin
  execution_id := public.start_session_job_attempt(p_job_id, 1, pg_temp.op651_id(32), 0, 'codex', 'gpt-5.5', 'code',
    'wallie/op651-branch-' || p_job_id);
  if execution_id is null then raise exception 'The branch attempt did not start.'; end if;
  perform public.pin_session_job_git_input(p_job_id, 1, execution_id, pg_temp.op651_id(34), 'main', repeat('a', 40));
  if not public.prepare_session_source_and_checkpoint_publication(execution_id, pg_temp.op651_id(34), 'main',
    repeat('a', 40), p_output_sha, 'Private branch output', 'Retained branch code', '',
    encode(sha256(bundle), 'hex'), encode(bundle, 'base64'), 0, 'Private branch artifact.') then
    raise exception 'The branch checkpoint was not prepared.';
  end if;
  lease := public.claim_session_checkpoint_publication(execution_id);
  select publication.retained_ref into strict ref from public.session_checkpoint_publications publication
  where publication.run_id = execution_id;
  if lease is null or not public.adopt_session_checkpoint_publication(execution_id, lease, ref, p_output_sha) then
    raise exception 'The branch checkpoint was not adopted.';
  end if;
  if not exists (select 1 from public.session_git_heads h where (h.session_id, h.checkpoint_run_id) = (p_session_id, execution_id)) then
    raise exception 'The adopted branch output is missing its own head.';
  end if;
  return execution_id;
end;
$$;

create function pg_temp.approve_branch(p_child_session_id uuid) returns uuid language sql as $$
  select approved.id from public.sessions owner
  cross join lateral public.approve_session_stage(owner.id, owner.workspace_id, owner.current_stage_id,
    owner.current_artifact_id, owner.current_artifact_version,
    pg_temp.op651_id(21), 'codex', 'gpt-5.5', 'code', owner.artifact_review_revision) approved
  where owner.id = p_child_session_id
$$;
