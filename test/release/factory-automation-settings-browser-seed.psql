-- Run against a disposable local project with a unique op651_fixture_namespace.
\o /dev/null
begin;
\ir ../../supabase/tests/fixtures/factory_automation_occurrences.psql

update public.workspaces set name = 'Automation settings qualification' where id = pg_temp.op651_id(11);

insert into auth.users(id, email)
values (pg_temp.op651_id(3), 'automation-manager-' || current_setting('wallie.op651_fixture_namespace') || '@example.test');
insert into public.workspace_members(id, workspace_id, user_id, kind, role)
values (pg_temp.op651_id(23), pg_temp.op651_id(11), pg_temp.op651_id(3), 'human', 'member');
select public.grant_factory_membership(workspace_id, factory_id, pg_temp.op651_id(1), pg_temp.op651_id(23), 'manager')
from op651_scope;
select public.grant_factory_membership(workspace_id, factory_id, pg_temp.op651_id(1), pg_temp.op651_id(22), 'member')
from op651_scope;

update auth.users
set instance_id = '00000000-0000-0000-0000-000000000000',
  aud = 'authenticated', role = 'authenticated', email_confirmed_at = now(), created_at = now(), updated_at = now(),
  encrypted_password = '', confirmation_token = '', recovery_token = '', email_change_token_new = '',
  email_change_token_current = '', reauthentication_token = '', email_change = '',
  raw_app_meta_data = '{"provider":"email","providers":["email"]}', raw_user_meta_data = '{}'
where id in (pg_temp.op651_id(1), pg_temp.op651_id(2), pg_temp.op651_id(3));
insert into auth.identities(id, provider_id, user_id, identity_data, provider, created_at, updated_at)
select gen_random_uuid(), id::text, id, jsonb_build_object('sub', id::text, 'email', email, 'email_verified', true),
  'email', now(), now()
from auth.users where id in (pg_temp.op651_id(1), pg_temp.op651_id(2), pg_temp.op651_id(3));

insert into public.workspace_onboarding(workspace_id, status, completed_at, selected_github_repository_id)
values (pg_temp.op651_id(11), 'completed', now(), pg_temp.op651_id(34))
on conflict (workspace_id) do update
set status = excluded.status, completed_at = excluded.completed_at,
  selected_github_repository_id = excluded.selected_github_repository_id;

select public.set_git_continuity_release(true, revision, 'Isolated automation settings browser fixture')
from public.get_git_continuity_release_state() where not enabled;

do $$
declare
  mismatched constant jsonb := '{"kind":"issue-state","stateId":"done","teamId":"platform","projectId":null}';
  receipt jsonb;
begin
  for number in 1..20 loop
    perform pg_temp.record_test_occurrence('browser-older-' || number, p_event => mismatched);
    receipt := public.admit_next_factory_automation_occurrence();
    if receipt->>'reason' is distinct from 'event_no_match' then
      raise exception 'The fixture did not record the older denied occurrence.';
    end if;
  end loop;

  perform pg_temp.record_test_occurrence('browser-admitted');
  receipt := public.admit_next_factory_automation_occurrence();
  if receipt->>'status' is distinct from 'admitted' or receipt->>'sessionId' is null then
    raise exception 'The fixture did not admit a linked session.';
  end if;

  perform pg_temp.record_test_occurrence('browser-denied', p_event => mismatched);
  receipt := public.admit_next_factory_automation_occurrence();
  if receipt->>'reason' is distinct from 'event_no_match' then
    raise exception 'The fixture did not record the latest denied occurrence.';
  end if;

  perform pg_temp.configure_test_automation(0, true, 1);
  perform pg_temp.record_test_occurrence('browser-paused');
  receipt := public.admit_next_factory_automation_occurrence();
  if receipt->>'status' is distinct from 'pending' or receipt->>'reason' is distinct from 'paused' then
    raise exception 'The fixture did not park the occurrence while paused.';
  end if;
end;
$$;

\o
select jsonb_build_object(
  'workspaceId', rule.workspace_id, 'workspaceSlug', workspace.slug, 'factoryId', rule.factory_id,
  'automationId', rule.automation_id, 'revisionId', rule.revision_id,
  'ownerId', pg_temp.op651_id(1), 'viewerId', pg_temp.op651_id(2), 'managerId', pg_temp.op651_id(3),
  'historyCount', 23
)::text
from automation_occurrence_rule rule join public.workspaces workspace on workspace.id = rule.workspace_id;
commit;
