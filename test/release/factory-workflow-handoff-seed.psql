\o /dev/null
begin;
do $$
begin
  if exists (select 1 from public.workspaces) then
    raise exception 'The M11 handoff requires a fresh disposable database without workspace seeds.';
  end if;
end;
$$;
\set op651_seed_only true
\set op651_parallel_only true
\unset op652_join_evidence
\ir ../../supabase/tests/fixtures/factory_workflow_branch.psql
\ir ../../supabase/tests/fixtures/factory_workflow_authored_setup.psql
\ir ../../supabase/tests/fixtures/factory_workflow_checkpoint_evidence.psql
select enabled.* from public.get_git_continuity_release_state() release
cross join lateral public.set_git_continuity_release(true,release.revision,'Disposable M11 worker handoff') enabled
where not release.enabled;
create temp table m11_preparation as
select session_id,job_id,pg_temp.adopt_source_checkpoint(session_id,job_id) as run_id
from authored_session;

\o
select jsonb_build_object(
  'workspaceId',scope.workspace_id,'factoryId',scope.factory_id,'memberId',pg_temp.op651_id(21),
  'sessionId',prep.session_id,'jobId',prep.job_id,'inputRunId',prep.run_id,
  'graphRevisionId',version.graph_revision_id,'activationId',version.activation_id,
  'workflowDigest',pin.workflow_digest,'stageId',session.current_stage_id,
  'artifactId',session.current_artifact_id,'artifactVersion',session.current_artifact_version,
  'reviewRevision',session.artifact_review_revision,'policyRevisionId',session.execution_policy_revision_id
)
from m11_preparation prep cross join authored_scope scope cross join authored_version_a version
join public.sessions session on session.id=prep.session_id
join internal.factory_workflow_authoring_session_pins pin on pin.session_id=prep.session_id
join internal.factory_workflow_authoring_dispatches dispatch on (dispatch.session_id,dispatch.input_run_id)=(prep.session_id,prep.run_id)
where dispatch.completed_at is null and dispatch.occurrence_id is null and session.phase_status='awaiting_review';
commit;
