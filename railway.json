{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": null,
    "watchPatterns": [
      "package.json",
      "pnpm-lock.yaml",
      "railway.json",
      "scripts/install-crash-handlers.mjs",
      "scripts/register-server-only.mjs",
      "src/env/**",
      "src/features/github/**",
      "src/features/sessions/**",
      "src/features/wallie/**",
      "src/lib/agent-config/**",
      "src/lib/agent-credentials/**",
      "src/lib/agent-runner/**",
      "src/lib/claude-code/**",
      "src/lib/codex/**",
      "src/lib/cursor/**",
      "src/lib/github/**",
      "src/lib/linear-routing/**",
      "src/lib/maintenance/**",
      "src/lib/pipeline/**",
      "src/lib/prompt-templates/**",
      "src/lib/sandbox/**",
      "src/lib/secrets/**",
      "src/lib/supabase/**",
      "src/lib/wallie/**",
      "src/worker/**"
    ]
  },
  "deploy": {
    "startCommand": "node --env-file-if-exists=.env.local --import ./scripts/install-crash-handlers.mjs --import ./scripts/register-server-only.mjs --import tsx src/worker/index.ts",
    "drainingSeconds": 2700,
    "overlapSeconds": 0,
    "healthcheckPath": null,
    "restartPolicyType": "ALWAYS"
  }
}
