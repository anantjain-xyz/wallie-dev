{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOnlyNamedRegionalBackupBucket",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT_ID>:user/wallie-local",
          "s3:LocationConstraint": "<REGION>"
        }
      }
    },
    {
      "Sid": "InitializeObjectLockBucket",
      "Effect": "Allow",
      "Action": ["s3:PutBucketVersioning", "s3:PutBucketObjectLockConfiguration"],
      "Resource": "arn:aws:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT_ID>:user/wallie-local"
        }
      }
    },
    {
      "Sid": "TagOnlyNamedBackupBucket",
      "Effect": "Allow",
      "Action": "s3:TagResource",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT_ID>:user/wallie-local",
          "aws:RequestTag/Name": "<BUCKET_NAME>",
          "aws:RequestTag/Project": "Wallie",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/WallieStack": "wallie-staging-backup",
          "aws:RequestTag/Component": "postgres-backup"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["Name", "Project", "Environment", "ManagedBy", "Component", "WallieStack"]
        }
      }
    },
    {
      "Sid": "ConfigureNamedBackupBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT_ID>:user/wallie-local"
        }
      }
    },
    {
      "Sid": "InspectNamedBackupBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:ListTagsForResource",
        "s3:GetBucketTagging",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketWebsite",
        "s3:GetBucketVersioning",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketLogging",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT_ID>:user/wallie-local"
        }
      }
    }
  ]
}
