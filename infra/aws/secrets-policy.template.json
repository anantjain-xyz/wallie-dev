{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateWebContainer",
      "Effect": "Allow",
      "Action": "secretsmanager:CreateSecret",
      "Resource": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:/wallie/staging/web/runtime-??????",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "aws:RequestedRegion": "<REGION>",
          "aws:RequestTag/WallieStack": "wallie-staging-application",
          "aws:RequestTag/Project": "Wallie",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Component": "runtime-secrets",
          "aws:RequestTag/Name": "/wallie/staging/web/runtime",
          "secretsmanager:Name": "/wallie/staging/web/runtime"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["WallieStack", "Project", "Environment", "ManagedBy", "Component", "Name"]
        },
        "Null": {
          "secretsmanager:AddReplicaRegions": "true",
          "secretsmanager:KmsKeyArn": "true",
          "secretsmanager:KmsKeyId": "true",
          "secretsmanager:Type": "true"
        },
        "BoolIfExists": {
          "secretsmanager:ForceOverwriteReplicaSecret": "false"
        }
      }
    },
    {
      "Sid": "TagWebContainer",
      "Effect": "Allow",
      "Action": "secretsmanager:TagResource",
      "Resource": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:/wallie/staging/web/runtime-??????",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "aws:RequestedRegion": "<REGION>",
          "aws:RequestTag/WallieStack": "wallie-staging-application",
          "aws:RequestTag/Project": "Wallie",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Component": "runtime-secrets",
          "aws:RequestTag/Name": "/wallie/staging/web/runtime"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["WallieStack", "Project", "Environment", "ManagedBy", "Component", "Name"]
        },
        "StringEqualsIfExists": {
          "aws:ResourceTag/WallieStack": "wallie-staging-application"
        }
      }
    },
    {
      "Sid": "CreateWorkerContainer",
      "Effect": "Allow",
      "Action": "secretsmanager:CreateSecret",
      "Resource": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:/wallie/staging/worker/runtime-??????",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "aws:RequestedRegion": "<REGION>",
          "aws:RequestTag/WallieStack": "wallie-staging-application",
          "aws:RequestTag/Project": "Wallie",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Component": "runtime-secrets",
          "aws:RequestTag/Name": "/wallie/staging/worker/runtime",
          "secretsmanager:Name": "/wallie/staging/worker/runtime"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["WallieStack", "Project", "Environment", "ManagedBy", "Component", "Name"]
        },
        "Null": {
          "secretsmanager:AddReplicaRegions": "true",
          "secretsmanager:KmsKeyArn": "true",
          "secretsmanager:KmsKeyId": "true",
          "secretsmanager:Type": "true"
        },
        "BoolIfExists": {
          "secretsmanager:ForceOverwriteReplicaSecret": "false"
        }
      }
    },
    {
      "Sid": "TagWorkerContainer",
      "Effect": "Allow",
      "Action": "secretsmanager:TagResource",
      "Resource": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:/wallie/staging/worker/runtime-??????",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "aws:RequestedRegion": "<REGION>",
          "aws:RequestTag/WallieStack": "wallie-staging-application",
          "aws:RequestTag/Project": "Wallie",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Component": "runtime-secrets",
          "aws:RequestTag/Name": "/wallie/staging/worker/runtime"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["WallieStack", "Project", "Environment", "ManagedBy", "Component", "Name"]
        },
        "StringEqualsIfExists": {
          "aws:ResourceTag/WallieStack": "wallie-staging-application"
        }
      }
    },
    {
      "Sid": "DescribeExactNames",
      "Effect": "Allow",
      "Action": "secretsmanager:DescribeSecret",
      "Resource": [
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:/wallie/staging/web/runtime",
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:/wallie/staging/web/runtime-??????",
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:/wallie/staging/worker/runtime",
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:/wallie/staging/worker/runtime-??????"
      ],
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "aws:RequestedRegion": "<REGION>"
        }
      }
    },
    {
      "Sid": "VerifyOwnedMetadata",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetResourcePolicy", "secretsmanager:ListSecretVersionIds"],
      "Resource": [
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:/wallie/staging/web/runtime-??????",
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:/wallie/staging/worker/runtime-??????"
      ],
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "aws:RequestedRegion": "<REGION>",
          "aws:ResourceTag/WallieStack": "wallie-staging-application"
        }
      }
    }
  ]
}
