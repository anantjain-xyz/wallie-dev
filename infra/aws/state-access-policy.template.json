{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:<PARTITION>:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "s3:ResourceAccount": "<ACCOUNT_ID>"
        }
      }
    },
    {
      "Sid": "ReadAndWriteStagingState",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:<PARTITION>:s3:::<BUCKET_NAME>/staging/foundation.tfstate",
        "arn:<PARTITION>:s3:::<BUCKET_NAME>/staging/registry.tfstate",
        "arn:<PARTITION>:s3:::<BUCKET_NAME>/staging/application.tfstate"
      ],
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "s3:ResourceAccount": "<ACCOUNT_ID>"
        }
      }
    },
    {
      "Sid": "ManageStagingStateLocks",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:<PARTITION>:s3:::<BUCKET_NAME>/staging/foundation.tfstate.tflock",
        "arn:<PARTITION>:s3:::<BUCKET_NAME>/staging/registry.tfstate.tflock",
        "arn:<PARTITION>:s3:::<BUCKET_NAME>/staging/application.tfstate.tflock"
      ],
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "<ACCOUNT_ID>",
          "s3:ResourceAccount": "<ACCOUNT_ID>"
        }
      }
    }
  ]
}
